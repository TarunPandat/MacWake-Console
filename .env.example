# Optional. Opens the single Mac of a console set up before multi-Mac support. Each Mac now pairs with its own token.
ADMIN_TOKEN=

# Upstash Redis (Vercel Marketplace "Upstash for Redis" sets these automatically).
# Leave empty for local dev: state is kept in .data/state.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional TURN relay for live screen viewing when a network blocks direct connections (some cellular carriers).
# Free: Metered Open Relay (https://metered.ca/tools/openrelay/, 20 GB/month, no card). Comma-separate several URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
